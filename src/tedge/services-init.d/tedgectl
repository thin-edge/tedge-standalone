#!/bin/sh
set -e

CONFIG_DIR="@CONFIG_DIR@"

if [ -f "$CONFIG_DIR/env" ]; then
    # shellcheck disable=SC1091
    . "$CONFIG_DIR/env"
fi

manage_initd() {
    command="$1"
    name="$2"

    # The combined 'tedge' service runs the agent and c8y mapper in one process via
    # `tedge run all`, which only exists on newer tedge binaries. The build drops a
    # marker file when the packaged binary supports it; when present, route the old
    # service names to the combined service, otherwise fall back to the separate
    # tedge-agent / tedge-mapper-* services. Checking a file (rather than launching
    # the tedge CLI) keeps tedgectl cheap on memory-constrained devices.
    case "$name" in
        tedge-mapper-*|tedge-agent)
            if [ -f "@CONFIG_DIR@/.tedge-run-all" ]; then
                name=tedge
            fi
            ;;
    esac

    # check for non-service related actions first
    case "$command" in
        restart_device)
            sync; sync;
            sleep 2;
            reboot;
            exit 0
            ;;
    esac

    SOURCE_SCRIPT=$(find "$CONFIG_DIR/services-init.d" -name "*$name" | head -n1)
    SERVICE_SCRIPT=$(find /etc/init.d -name "*$name" | head -n1)
    if [ -z "$SERVICE_SCRIPT" ]; then
        # use default location
        SERVICE_SCRIPT="/etc/init.d/$(basename "$SOURCE_SCRIPT")"
    fi

    case "$command" in
        is_available)
            exit 0
            ;;
        start)
            "$SERVICE_SCRIPT" start
            ;;
        stop)
            # don't stop a service that does not exist
            if [ -f "$SERVICE_SCRIPT" ]; then
                "$SERVICE_SCRIPT" stop
            fi
            ;;
        restart)
            # tedge connect will do a restart then enable the service
            manage_initd enable "$name" ||:
            "$SERVICE_SCRIPT" restart
            ;;
        enable)
            if command -V update-rc.d >/dev/null 2>&1; then
                update-rc.d "$(basename "$SERVICE_SCRIPT")" defaults ||:
            fi
            ln -sf "$SOURCE_SCRIPT" "$SERVICE_SCRIPT"
            ;;
        disable)
            rm -f "$SERVICE_SCRIPT"
            ;;
        is_active|status)
            "$SERVICE_SCRIPT" status
            ;;
        *) echo "Unsupported command. command=$command"; exit 1 ;;
    esac
}

##############################
# Main
##############################
COMMAND="$1"
SERVICE_NAME=""
if [ $# -ge 2 ]; then
    SERVICE_NAME="$2"
fi
manage_initd "$COMMAND" "$SERVICE_NAME"
