#!/bin/sh
#/etc/init.d/tedge: tedge is a thin-edge.io component to support operations

### BEGIN INIT INFO
# Provides:          tedge
# Short-Description: tedge is a thin-edge.io component to support operations
# Required-Start:    $all
# Required-Stop:     $all
# Should-Start:      
# Should-Stop:       
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

# shellcheck disable=SC1090
# shellcheck disable=SC1091

set -e

CONFIG_DIR="@CONFIG_DIR@"
BIN=@CONFIG_DIR@/bin

if [ -f "$CONFIG_DIR/env" ]; then
    # shellcheck disable=SC1091
    . "$CONFIG_DIR/env"
fi

PATH=/bin:/usr/bin:/sbin:/usr/sbin:$BIN

# For configuration of the init script use the file
# /etc/default/tedge, do not edit this init script.

# Set run_service to 1 to start tedge or 0 to disable it.
run_service=1

# Run as root as sudo is not generally available
DAEMON="$BIN/tedge"
DAEMON_ARGS="run all c8y"
DAEMON_USER="root"
LOG_FILE=/var/log/tedge.log

export TEDGE_RUN_LOCK_FILES="false"

[ -e "/etc/default/tedge" ] && . "/etc/default/tedge"

PIDFILE=/run/lock/tedge.lock
if [ -d /run/lock ]; then
    PIDFILE=/run/lock/tedge.lock
else
    PIDFILE=/var/run/tedge.lock
fi

STOP_RETRY_SCHEDULE='TERM/30/KILL/1'

# Mock Debian helper functions when not being run on a debian based OS
log_begin_msg() {
    printf "%s" "$*"
}

log_end_msg() {
    if [ "$1" = "0" ]; then
        echo 'done'
    else
        echo 'error'
    fi
}

log_daemon_msg() {
    echo "$*"
}

log_progress_msg() {
    echo "$*"
}

# TODO: Can the imports be excluded if the mocked functions are used above?
if [ -f /lib/lsb/init-functions ]; then
	# Debian based systems including WSL (ubuntu)
	. /lib/lsb/init-functions
fi

if [ -f /etc/init.d/functions ]; then
	# YOCTO
	. /etc/init.d/functions
fi

# Fallback daemon control for systems without start-stop-daemon
# (e.g. minimal busybox based devices with very few dependencies).
have_start_stop_daemon() {
    command -v start-stop-daemon >/dev/null 2>&1
}

# Echo the pid recorded in the given pidfile, but only if it is still alive.
running_pid() {
    _pidfile="$1"
    [ -f "$_pidfile" ] || return 1
    _pid=$(cat "$_pidfile" 2>/dev/null)
    [ -n "$_pid" ] || return 1
    kill -0 "$_pid" 2>/dev/null || return 1
    echo "$_pid"
}

# Start the daemon in the background and record its pid, mimicking
# start-stop-daemon --start --background --make-pidfile --oknodo.
fallback_start() {
    # Already running? Nothing to do (mimics --oknodo).
    if running_pid "$PIDFILE" >/dev/null 2>&1; then
        return 0
    fi

    _run="exec $DAEMON $DAEMON_ARGS >> \"$LOG_FILE\" 2>&1"
    if [ -n "$DAEMON_USER" ] && [ "$DAEMON_USER" != "root" ] && [ "$(id -u 2>/dev/null)" = "0" ]; then
        # Drop privileges. Prefer setpriv, which execs and so keeps the pid we
        # record below valid; fall back to su otherwise.
        if command -v setpriv >/dev/null 2>&1; then
            setpriv --reuid "$DAEMON_USER" --regid "$DAEMON_USER" --init-groups /bin/sh -c "$_run" &
        elif command -v su >/dev/null 2>&1; then
            su -s /bin/sh "$DAEMON_USER" -c "$_run" &
        else
            /bin/sh -c "$_run" &
        fi
    else
        /bin/sh -c "$_run" &
    fi
    echo $! > "$PIDFILE"
}

# Stop the daemon recorded in the pidfile, mimicking the TERM (up to 30s) then
# KILL retry schedule used with start-stop-daemon.
fallback_stop() {
    _pid=$(running_pid "$PIDFILE" 2>/dev/null) || { rm -f "$PIDFILE"; return 0; }

    kill -TERM "$_pid" 2>/dev/null ||:
    _i=0
    while [ "$_i" -lt 30 ]; do
        kill -0 "$_pid" 2>/dev/null || break
        sleep 1
        _i=$((_i + 1))
    done
    if kill -0 "$_pid" 2>/dev/null; then
        kill -KILL "$_pid" 2>/dev/null ||:
    fi
    rm -f "$PIDFILE"
    return 0
}

do_start() {
    if [ $run_service = 1 ]
    then
        log_begin_msg "Starting tedge daemon..."
        tedge init --user "$DAEMON_USER" --group "$DAEMON_USER" ||:

        # Create log file with given user so it can write to it (for non-root users)
        touch "$LOG_FILE"
        if [ -n "$DAEMON_USER" ]; then
            chown "$DAEMON_USER" "$LOG_FILE"
        fi

        if have_start_stop_daemon; then
            start-stop-daemon --start --quiet --oknodo --background --make-pidfile --pidfile "$PIDFILE" --chuid "${DAEMON_USER}" --user "${DAEMON_USER}" \
                    --startas /bin/sh -- -c "exec $DAEMON $DAEMON_ARGS >> '$LOG_FILE' 2>&1"
        else
            fallback_start
        fi
        log_end_msg $?
    fi
}

do_stop() {
    if [ $run_service = 1 ]
    then
        log_begin_msg "Stopping tedge daemon..."

        if have_start_stop_daemon; then
            if start-stop-daemon --stop --quiet --oknodo --retry "$STOP_RETRY_SCHEDULE" --pidfile "${PIDFILE}" --user "${DAEMON_USER}"; then
                log_end_msg 0
                rm -f "${PIDFILE}"
            else
                log_end_msg 1
            fi
        elif fallback_stop; then
            log_end_msg 0
        else
            log_end_msg 1
        fi
    fi
}

case "$1" in
  start)
    do_start
    ;;

  stop)
    do_stop
    ;;

  restart)
    do_stop
    do_start
    ;;

  try-restart|force-reload)
      if [ $run_service = 0 ]; then exit 0; fi
    log_daemon_msg "Restarting tedge"
    # force-reload is the same as reload or try-restart according
    # to its definition, the reload is not implemented here, so
    # force-reload is the alias of try-restart here, but it should
    # be the alias of reload if reload is implemented.
    #
    # Only start the service when do_stop succeeds
    do_stop && do_start
    ;;

  status)
    if command -V status_of_proc >/dev/null 2>&1; then
        status_of_proc -p "${PIDFILE}" "${DAEMON}" "tedge" && exit 0 || exit $?
    elif command -V status >/dev/null 2>&1; then
        status "${DAEMON}" && exit 0 || exit $?
    elif running_pid "$PIDFILE" >/dev/null 2>&1; then
        exit 0
    else
        pidof "$(basename "${DAEMON}")" >/dev/null 2>&1 && exit 0 || exit 3
    fi
    ;;

  *)
    echo "Usage: /etc/init.d/tedge {start|stop|status|restart|try-restart|force-reload}" >&2
    exit 1

esac

exit 0