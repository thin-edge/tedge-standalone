#!/bin/sh
set -e

export SVDIR="${SVDIR:-/run/services}"
export RUNIT_SRCDIR="${RUNIT_SRCDIR:-@CONFIG_DIR@/services}"

if [ -f @CONFIG_DIR@/env ]; then
    # shellcheck disable=SC1091
    . @CONFIG_DIR@/env
fi

manage_runit() {
    command="$1"
    name="$2"

    # The combined 'tedge' service runs the agent and c8y mapper in one process via
    # `tedge run all`, which only exists on newer tedge binaries. The build drops a
    # marker file when the packaged binary supports it; when present, route the old
    # service names to the combined service, otherwise fall back to the separate
    # tedge-agent / tedge-mapper-* services. Checking a file (rather than launching
    # the tedge CLI) keeps tedgectl cheap on memory-constrained devices.
    case "$name" in
        tedge-mapper-*|tedge-agent)
            if [ -f "@CONFIG_DIR@/.tedge-run-all" ]; then
                name=tedge
            fi
            ;;
    esac

    case "$command" in
        is_available)
            # Check if runit instance is active
            pgrep -f "runsvdir -P $SVDIR" >/dev/null 2>&1
            ;;
        start)
            manage_runit enable "$name" ||:
            sv start "$name" ||:
            ;;
        stop)
            sv stop "$name" ||:
            ;;
        restart)
            manage_runit enable "$name" ||:
            sv restart "$name" ||:
            ;;
        enable)
            if [ ! -d "$SVDIR/$name" ]; then
                ln -s "$RUNIT_SRCDIR/$name" "$SVDIR/"
            fi
            # Remove file (if it exists)
            rm -f "$RUNIT_SRCDIR/$name/down"
            ;;
        disable)
            if [ -d "$RUNIT_SRCDIR/$name" ]; then
                touch "$RUNIT_SRCDIR/$name/down"
            fi
            ;;
        is_active|status) sv status "$name" ;;
        restart_device)
            shutdown -r now
            ;;
        *) echo "Unsupported command. command=$command"; exit 1 ;;
    esac
}

##############################
# Main
##############################
COMMAND="$1"
SERVICE_NAME=""
if [ $# -ge 2 ]; then
    SERVICE_NAME="$2"
fi
manage_runit "$COMMAND" "$SERVICE_NAME"
