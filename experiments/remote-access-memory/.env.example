# Copy to .env and fill in, OR rely on the repo-root .env (which already has these).
# go-c8y-cli reads C8Y_HOST/C8Y_USER/C8Y_PASSWORD/C8Y_TENANT; the harness maps
# C8Y_BASEURL -> C8Y_HOST automatically if only the repo .env is present.

C8Y_BASEURL=https://example.cumulocity.com
C8Y_USER=your-user@example.com
C8Y_PASSWORD=your-password
C8Y_TENANT=t12345

# Optional overrides
# TEDGE_ARCH=arm64          # arm64 (Apple Silicon / ARM) or amd64
# DURATION=15               # seconds to sample while the tunnel is open
# DELETE_DEVICE=1           # delete the test device from C8y after each run
