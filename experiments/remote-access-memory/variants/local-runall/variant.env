# Validate the REAL local packaging (your src/tedge changes: the single "tedge"
# service + tedgectl remap) with the tedge main binary, installed exactly as a
# customer would via install.sh --file.
#
# run-variants.sh rebuilds the package from src/tedge when BUILD_FROM_SRC=1.
LABEL=local-runall
BUILD_FROM_SRC=1
LOCAL_PACKAGE=variants/local-runall/package.tar.gz
PKG_CHANNEL=main
PKG_VERSION=latest
TEDGE_BINARY=none
OVERLAY=
