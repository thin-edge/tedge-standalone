# Test: run tedge-agent + tedge-mapper-c8y as a SINGLE process via `tedge run all c8y`
# (a tedge main-branch feature). Fewer processes => the multicall binary baseline is
# paid once instead of twice, which should reduce total memory.
# Uses the Cloudsmith `main` binary and an overlay that swaps the service definitions.
LABEL=main-runall
BASE_VERSION=2.0.1-3
BASE_VARIANT=-noupx
TEDGE_BINARY=cloudsmith
TEDGE_CHANNEL=main
TEDGE_BINARY_VERSION=latest
TEDGE_BINARY_UPX=0
OVERLAY=main-runall/overlay
