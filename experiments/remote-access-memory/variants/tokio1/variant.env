# Test: launch the c8y-remote-access-plugin with TOKIO_WORKER_THREADS=1 to see if
# a single-threaded tokio runtime reduces the plugin's memory overhead.
# Same release binary as the `release` control — only the launch env differs.
LABEL=tokio1
BASE_VERSION=2.0.1-3
BASE_VARIANT=-noupx
TEDGE_BINARY=none
OVERLAY=tokio1/overlay
