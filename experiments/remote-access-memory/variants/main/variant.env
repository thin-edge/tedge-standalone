# Control for the run-all comparison: the tedge `main` channel binary from
# Cloudsmith, but with the STANDARD separate services (tedge-agent + tedge-mapper-c8y).
LABEL=main-separate
BASE_VERSION=2.0.1-3
BASE_VARIANT=-noupx
TEDGE_BINARY=cloudsmith
TEDGE_CHANNEL=main
TEDGE_BINARY_VERSION=latest
TEDGE_BINARY_UPX=0
OVERLAY=
